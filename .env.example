# Mentra app credentials (from console.mentraglass.com)
PACKAGE_NAME=com.yourorg.streamrestore
MENTRAOS_API_KEY=replace-me
PORT=3000

# RTK ingest endpoint (separate Express server)
GPS_INGEST_PORT=3100
GPS_INGEST_TOKEN=change-me-to-a-long-random-string

# Markers file (GeoJSON or CSV) to load on session start.
# Path is relative to the project root, or use an https:// URL.
MARKERS_FILE=./examples/markers.geojson

# Tolerances (meters)
HORIZONTAL_TOLERANCE_M=0.30
DEPTH_TOLERANCE_M=0.05

# How long until a fix is considered stale and we warn the operator
FIX_STALE_MS=4000

# Where to write per-user as-built audit logs (one CSV per user).
# Downloadable via GET /asbuilt/<userId>.csv (bearer auth required).
AUDIT_DIR=./audit

# Public base URL for the Mentra app (your ngrok https URL in dev, your domain in prod).
# Used to build absolute URLs for sound effects fetched by the glasses.
# Example: https://stream-restore.ngrok.app
PUBLIC_BASE_URL=

# Optional explicit override for the on-grade ding URL. If set, takes precedence over
# PUBLIC_BASE_URL/sfx/on-grade.wav. Use this if you want to host the sound elsewhere.
SFX_ON_GRADE_URL=

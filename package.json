{
  "name": "stream-restoration-glasses",
  "version": "0.1.0",
  "description": "MentraOS smart-glasses HUD for stream restoration crews — RTK-driven dig depth & marker guidance.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "simulate": "bun run scripts/simulate-rtk.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mentra/sdk": "^2.0.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.41",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
